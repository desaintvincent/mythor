{
  "name": "@mythor/renderer3d",
  "version": "0.1.0",
  "description": "Mythor 3D renderer (perspective camera, depth-tested WebGL2 rendering)",
  "author": "thomas <destvincent@hotmail.fr>",
  "homepage": "https://github.com/desaintvincent/mythor/blob/main/packages/renderer3d#readme",
  "license": "MIT",
  "main": "lib/renderer3d.js",
  "module": "lib/esm/renderer3d.js",
  "typings": "lib/renderer3d.d.ts",
  "sideEffects": false,
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package-json.js",
    "start": "tsc --watch",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs ./src/renderer3d.ts",
    "clean": "rm -rf lib docs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@mythor/core": "^0.4.10",
    "@mythor/events": "^0.4.6",
    "@mythor/math": "^0.3.10",
    "@mythor/gl-utils": "^0.1.0"
  },
  "devDependencies": {
    "@mythor/eslint-config": "^1.3.9"
  }
}

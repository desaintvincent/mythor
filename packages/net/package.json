{
  "name": "@mythor/net",
  "description": "Mythor net",
  "version": "0.1.0",
  "author": "thomas <destvincent@hotmail.fr>",
  "homepage": "https://github.com/desaintvincent/mythor/blob/main/packages/net#readme",
  "license": "MIT",
  "main": "lib/net.js",
  "module": "lib/esm/net.js",
  "typings": "lib/net.d.ts",
  "exports": {
    ".": {
      "types": "./lib/net.d.ts",
      "import": "./lib/esm/net.js",
      "require": "./lib/net.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/esm/server.js",
      "require": "./lib/server.js"
    }
  },
  "sideEffects": false,
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "server"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package-json.js",
    "start": "tsc --watch",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs ./src/net.ts",
    "clean": "rm -rf lib docs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@mythor/core": "^0.4.10",
    "@mythor/math": "^0.3.10",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@mythor/eslint-config": "^1.3.9",
    "@types/ws": "^8.5.4"
  }
}

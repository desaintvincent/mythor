{
  "name": "@mythor/gl-utils",
  "version": "0.1.0",
  "description": "Mythor low-level WebGL2 utilities (shader/program compilation, buffers, textures, color)",
  "author": "thomas <destvincent@hotmail.fr>",
  "homepage": "https://github.com/desaintvincent/mythor/blob/main/packages/gl-utils#readme",
  "license": "MIT",
  "main": "lib/gl-utils.js",
  "module": "lib/esm/gl-utils.js",
  "typings": "lib/gl-utils.d.ts",
  "sideEffects": false,
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package-json.js",
    "start": "tsc --watch",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs ./src/gl-utils.ts",
    "clean": "rm -rf lib docs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@mythor/eslint-config": "^1.3.9"
  }
}

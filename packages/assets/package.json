{
  "name": "@mythor/assets",
  "version": "0.1.0",
  "description": "Mythor assets",
  "author": "thomas <destvincent@hotmail.fr>",
  "homepage": "https://github.com/desaintvincent/mythor/blob/main/packages/assets#readme",
  "license": "MIT",
  "main": "lib/assets.js",
  "typings": "lib/assets.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsc --watch",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs ./src/assets.ts",
    "clean": "rm -rf lib docs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@mythor/eslint-config": "^1.3.9"
  },
  "dependencies": {
    "@mythor/core": "^0.4.10"
  }
}

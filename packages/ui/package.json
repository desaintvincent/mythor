    "type": "git",
    "url": "git+https://github.com/desaintvincent/mythor.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc --watch",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs ./src/ui.ts",
    "clean": "rm -rf dist docs",
    "lint": "eslint . --max-warnings 0"
  },
  "bugs": {
    "url": "https://github.com/desaintvincent/mythor/issues"
  },
  "dependencies": {
    "@mythor/core": "^0.4.10",
    "@mythor/events": "^0.4.6",
    "@mythor/math": "^0.3.10",
    "@mythor/renderer": "^0.6.1"
  }
}

{
  "name": "@mythor/ui",
  "version": "0.1.0",
  "description": "Mythor UI primitives",
  "author": "Thomas Robert de Saint Vincent <thomas.rdsv@viaco.fr>",
  "homepage": "https://github.com/desaintvincent/mythor/blob/main/packages/ui#readme",
  "license": "MIT",
  "main": "lib/ui.js",
  "typings": "lib/ui.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib"
  ],
